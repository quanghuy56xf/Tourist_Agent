DATABASE_URL=sqlite:///./data/app.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./uploads
SIMILARITY_THRESHOLD=0.75
SEARCH_TOP_K=20
SEARCH_TOP_N=3
USE_AUGMENTATION=true
CORS_ORIGINS=http://localhost:3000
# Bat khi dung ngrok (URL doi moi lan restart ngrok)
CORS_ALLOW_ALL=true

# RAG Configuration
GOOGLE_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_CHARS=8000
LLM_MAX_CHAT_HISTORY_CHARS=6000
LLM_MAX_CHAT_HISTORY_MESSAGES=10
RAG_CHROMA_PATH=./data/rag_chroma
RAG_BM25_PATH=./data/rag/bm25_index.pkl
RAG_CHUNKS_PATH=./data/rag/chunks.pkl
MODEL_WARMUP_ENABLED=false
CONTENT_PREWARM_ENABLED=false
CONTENT_PREWARM_ALL_VARIANTS=true
GROUP_DOCS_DIR=./data/group_docs

# Optional admin protection for mutation endpoints
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
MANAGER_USERNAME=manager
MANAGER_PASSWORD=replace-with-manager-password
AUTH_TOKEN_SECRET=replace-with-a-random-secret
